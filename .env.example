# Required for Buyoll.AI Gemini product advisor (server-side only)
GEMINI_API_KEY=""

# Required on Render so user login sessions persist across restarts and redeploys
SESSION_SECRET=""

# Comma-separated frontend origins allowed for cross-site cookies/CORS (e.g. https://buyoll.onrender.com)
CORS_ORIGINS=""

# Optional admin passcode override (if empty, first admin sets password in UI)
ADMIN_PASSCODE=""

# Optional public URL of your deployed Render service
APP_URL=""

# Optional directory path for persistent JSON data & uploads (point to Render Persistent Disk mount path)
DATA_DIR=""

# Optional remote API base URL (leave empty when serving frontend + backend together on Render)
VITE_API_URL=""
